module train_memory (
    input wire clk,
    input wire [7:0] addr,  // sample index (0–255)
    output reg [15:0] features [3:0],  // 4 features per sample
    output reg [1:0] label             // 3 classes (0–2), fits in 2 bits
);

    // Fixed-point representation (e.g., Q8.8)
    // Fill this with actual Iris data converted to fixed-point!
    reg [15:0] data_mem [0:255][0:3];
    reg [1:0] label_mem [0:255];

    integer i;

    initial begin
        // Example initialization — replace with actual fixed-point values
        // Sample 0
        data_mem[0][0] = 16'h0519; // 5.1
        data_mem[0][1] = 16'h0380; // 3.5
        data_mem[0][2] = 16'h0166; // 1.4
        data_mem[0][3] = 16'h0033; // 0.2
        label_mem[0] = 2'd0;

        // Add rest of the 256 training samples here...
    end

    always @(posedge clk) begin
        for (i = 0; i < 4; i = i + 1)
            features[i] <= data_mem[addr][i];
        label <= label_mem[addr];
    end
endmodule
